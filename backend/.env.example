# SQLite file location. Locally the default is backend/data/app.db.
# On Railway, mount a volume at /data and use: sqlite:////data/app.db
DATABASE_URL=sqlite:///./data/app.db
# Where uploaded files are stored. On Railway: /data/uploads (same volume).
UPLOAD_DIR=./data/uploads
# Browser origins allowed to call the API directly (comma-separated).
# The frontend proxies /api/* server-side, so this only matters for direct calls.
CORS_ORIGINS=http://localhost:3000
# Seed demo forms/responses when the database is empty (first boot).
SEED_ON_EMPTY=true
